From 8153cec7d5d62e1bee862b7705002427dd813e66 Mon Sep 17 00:00:00 2001
From: Stanislav Levin <slev@altlinux.org>
Date: Thu, 20 Aug 2026 17:03:07 +0300
Subject: [PATCH] ipatests: skip test_drop_privileges if run as unprivileged
 user

https://codeberg.org/freeipa/freeipa/src/commit/b16f3b80dc5969c303ea71fe5d5080977d2c50c4/ipaclient/install/ipa_epn.py#L113-L118

`drop_privileges` does nothing if run as non-root while test
`test_drop_privileges` expects it to raise an exception. So skip
this test in unprivileged environments.

Fixes: https://codeberg.org/freeipa/freeipa/issues/10035
Signed-off-by: Stanislav Levin <slev@altlinux.org>
Reviewed-By: David Hanina <dhanina@redhat.com>
---
 ipatests/test_ipaclient/test_epn.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/ipatests/test_ipaclient/test_epn.py b/ipatests/test_ipaclient/test_epn.py
index 226d0c319..5b9ff8e3a 100644
--- a/ipatests/test_ipaclient/test_epn.py
+++ b/ipatests/test_ipaclient/test_epn.py
@@ -1,6 +1,7 @@
 #
 # Copyright (C) 2026  FreeIPA Contributors see COPYING for license
 #
+import os
 
 import pytest
 import ipatests.util
@@ -11,6 +12,10 @@ from ipaclient.install.ipa_epn import drop_privileges
 from ipapython import admintool
 
 
+@pytest.mark.skipif(
+    os.geteuid() != 0,
+    reason="Must have root privileges to run this test",
+)
 @pytest.mark.parametrize(
     "user,group", [
         ("unknown_user", "daemon"),
-- 
2.56.0


From 438cad140939f7fabbb7a9200565c0c04b4f74ed Mon Sep 17 00:00:00 2001
From: Alexander Bokovoy <abokovoy@redhat.com>
Date: Mon, 31 Aug 2026 19:21:56 +0300
Subject: [PATCH 85/91] admins: grant admins group all default privileges

Now all API operations that either modify LDAP or launch oddjob tasks
require presence of the object-specific privileges. Administrators must
possess them to be able to continue administrative tasks.

Fixes: CVE-2026-79678

Signed-off-by: Alexander Bokovoy <abokovoy@redhat.com>
(cherry picked from commit 83d38aa10a93da6e5ae0e0494a7a78b3989546f5)
---
 install/updates/91-admins-privileges.update | 121 ++++++++++++++++++++
 install/updates/Makefile.am                 |   1 +
 2 files changed, 122 insertions(+)
 create mode 100644 install/updates/91-admins-privileges.update

diff --git a/install/updates/91-admins-privileges.update b/install/updates/91-admins-privileges.update
new file mode 100644
index 000000000..533259f27
--- /dev/null
+++ b/install/updates/91-admins-privileges.update
@@ -0,0 +1,121 @@
+# Make the administrative 'admins' group a default member of all default
+# privileges referenced by managed permissions.
+#
+# Privilege-based operation enforcement (see BaseLDAPCommand
+# enforce_managed_permissions) requires the calling context to hold one of
+# the default privileges of the managed permission covering the requested
+# operation. The 'admins' group historically relied on legacy ACIs only, so
+# grant it every default privilege to keep administrative users in full
+# control.
+
+# These two privileges are created only by install/share/delegation.ldif on
+# fresh installs, so create them here for the upgrade path.
+
+dn: cn=Certificate Administrators,cn=privileges,cn=pbac,$SUFFIX
+default: objectClass: top
+default: objectClass: groupofnames
+default: objectClass: nestedgroup
+default: cn: Certificate Administrators
+default: description: Certificate Administrators
+add: member: cn=admins,cn=groups,cn=accounts,$SUFFIX
+
+dn: cn=Stage User Provisioning,cn=privileges,cn=pbac,$SUFFIX
+default: objectClass: top
+default: objectClass: groupofnames
+default: objectClass: nestedgroup
+default: cn: Stage User Provisioning
+default: description: Stage User Provisioning
+add: member: cn=admins,cn=groups,cn=accounts,$SUFFIX

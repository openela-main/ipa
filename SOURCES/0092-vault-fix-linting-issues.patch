From d1a663f0621d18b33e31669bd489196558e2106a Mon Sep 17 00:00:00 2001
From: Alexander Bokovoy <abokovoy@redhat.com>
Date: Tue, 1 Sep 2026 21:12:42 +0300
Subject: [PATCH 92/96] vault: fix linting issues

Both arms of api.env.in_server check should result in the defined
classes and constants to allow successful compile for linters. At
runtime we use pki modules that provide correct values, while linters
should be OK with their replacements.

Signed-off-by: Alexander Bokovoy <abokovoy@redhat.com>
(cherry picked from commit 238925fe9b59716a9c620b5dc20f020b1e9a6536)
---
 ipaserver/plugins/vault.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/ipaserver/plugins/vault.py b/ipaserver/plugins/vault.py
index e11c7e92e..82511308f 100644
--- a/ipaserver/plugins/vault.py
+++ b/ipaserver/plugins/vault.py
@@ -46,6 +46,10 @@ if api.env.in_server:
     from pki.crypto import DES_EDE3_CBC_OID
     from pki.crypto import AES_128_CBC_OID
     from pki import PKIException
+else:
+    DES_EDE3_CBC_OID = "{1 2 840 113549 3 7}"
+    AES_128_CBC_OID = "{2 16 840 1 101 3 4 1 2}"
+    PKIException = Exception
 
 if six.PY3:
     unicode = str
-- 
2.55.0


From 175cdfb70c7ecdc43b2cbbc9faf736e0dff73460 Mon Sep 17 00:00:00 2001
From: Alexander Bokovoy <abokovoy@redhat.com>
Date: Tue, 1 Sep 2026 20:55:42 +0300
Subject: [PATCH 91/91] vault: document why vaultconfig_show is intentionally
 ungated

vaultconfig_show reaches the KRA as the RA agent but returns only public
material (the transport certificate and the list of KRA servers) and is a
prerequisite of every vault archive/retrieve for any owner or member, so it
must remain callable without a privilege. Explain why no gate is applied.

Signed-off-by: Alexander Bokovoy <abokovoy@redhat.com>
(cherry picked from commit 768d0c3259aef5c01915bd7181a2a339b32be2b4)
---
 ipaserver/plugins/vault.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/ipaserver/plugins/vault.py b/ipaserver/plugins/vault.py
index 13c4fac9a..e11c7e92e 100644
--- a/ipaserver/plugins/vault.py
+++ b/ipaserver/plugins/vault.py
@@ -1007,6 +1007,15 @@ class vaultconfig_show(Retrieve):
     )
 
     def execute(self, *args, **options):
+        # Intentionally not gated by a privilege check. Although the KRA
+        # client below runs as the RA agent (bypassing the caller's LDAP
+        # ACIs), this command returns only public material: the KRA
+        # transport certificate and the list of KRA servers. It is also a
+        # prerequisite of every vault archive/retrieve -- the client fetches
+        # the transport cert here before wrapping/unwrapping a secret (see
+        # ipaclient/plugins/vault.py) -- so any vault owner or member, not
+        # just administrators, must be able to call it. The only gate is
+        # authentication, which the framework already enforces.
         if not self.api.Command.kra_is_enabled()['result']:
             raise errors.InvocationError(
                 format=_('KRA service is not enabled'))
